      "version": 4,
      "parameters": {
        "__IMTCONN__": 0
      },
      "mapper": {
        "to": [
          "contractor-test@example.com"
        ],
        "subject": "New Maintenance Job Assigned",
        "bodyType": "collection",
        "contents": [
          {
            "text": "Hello,\r\n\r\nA new maintenance request has been assigned to you.\r\n\r\nTenant: {{1.`1`}}\r\nApartment: {{1.`3`}}\r\nIssue: {{1.`4`}}\r\nRequest Date: {{1.`5`}}\r\n\r\nPlease review the request and confirm your availability.\r\n\r\nThank you,\r\nProperty Maintenance Team",
            "image": {}
          }
        ]
      },
      "metadata": {
        "designer": {
          "x": 1800,
          "y": 0
        },
        "parameters": [
          {
            "name": "__IMTCONN__",
            "type": "account:google-email",
            "label": "Connection",
            "required": true
          }
        ],
        "expect": [
          {
